# Example environment configuration for local development.
# Copy to `.env` and adjust. NEVER commit a real `.env` or real secrets.

# --- Application ---------------------------------------------------------------
APP_NAME=news-intelligence-api
# local | dev | staging | prod  (local/test allow unauthenticated mutations)
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
# Host port for the local Compose API. Compose binds it to loopback only.
API_HOST_PORT=8000
# Gate G: leave false until prediction-backed public reads are explicitly approved.
CRISIS_PREDICTION_READS_ENABLED=false

# --- Datastores ----------------------------------------------------------------
# Inside Docker Compose use the service hostnames (postgres, redis); for host-run
# processes use localhost.
DATABASE_URL=postgresql+psycopg2://news:news@localhost:5432/news
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_POOL_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379/0

# --- Celery --------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Security ------------------------------------------------------------------
# Leave empty for local-only mutations. Set a long random value before any nonlocal
# exposure; the API-key middleware will then require it on mutating requests.
API_KEY=
# Comma-separated allow-list of CORS origins (no wildcards; allow_credentials is off).
# The no-build static frontend (ADR 0007) is served with no build step, e.g.:
#   python -m http.server 3000 --directory frontend
# which is reachable at both host spellings, so both are allow-listed by default.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM providers -------------------------------------------------------------
# Keys remain empty in source control. Anthropic/OpenAI are the default reasoning routes;
# Gemini/DeepSeek adapters are available but are not called unless LLM_TIER_PROVIDERS or
# LLM_TIER_FALLBACKS explicitly route a tier to them. LLM_MODELS selects model IDs only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Keep Gemini's hidden thought tokens from consuming the JSON response budget. The map is keyed
# by exact model id and replaces the default as a whole; every routed Gemini model must be listed.
GEMINI_MODEL_THINKING_LEVELS={"gemini-3.5-flash-lite":"minimal","gemini-3.6-flash":"low"}

# Opt-in example: Gemini primary and DeepSeek fallback for T1. Copy all three JSON values
# together; map-valued environment settings replace their defaults rather than merging.
# LLM_MODELS={"T0":"text-embedding-3-small","T1":"gemini-3.6-flash","T2":"claude-sonnet-5","T3":"gpt-4.1"}
# LLM_TIER_PROVIDERS={"T0":"openai","T1":"gemini","T2":"anthropic","T3":"openai"}
# LLM_TIER_FALLBACKS={"T1":[{"provider":"deepseek","model":"deepseek-v4-flash"}],"T2":[{"provider":"openai","model":"gpt-4.1"}]}

# --- Postgres container bootstrap (used by docker-compose) ---------------------
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news
# Host port the container's 5432 is published on. Change it when a local PostgreSQL
# already owns 5432. Host-run processes (pytest, alembic) read this too, so DATABASE_URL
# above must use the same port.
POSTGRES_HOST_PORT=5432

# --- NLP / embedding snapshot --------------------------------------------------
# `current` is retained only as the label on unknown legacy vectors. Before live embedding
# writes, capture and verify a candidate, run `scripts/capture-embedding-snapshot.py activate`,
# then set the returned id here and keep enforcement enabled. Never invent or date-stamp an id.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=current
EMBEDDING_REQUIRE_REGISTERED_SNAPSHOT=true
