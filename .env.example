# Example environment configuration for local development.
# Copy to `.env` and adjust. NEVER commit a real `.env` or real secrets.

# --- Application ---------------------------------------------------------------
APP_NAME=news-intelligence-api
# local | dev | staging | prod  (local/test allow unauthenticated mutations)
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO

# --- Datastores ----------------------------------------------------------------
# Inside Docker Compose use the service hostnames (postgres, redis); for host-run
# processes use localhost.
DATABASE_URL=postgresql+psycopg2://news:news@localhost:5432/news
REDIS_URL=redis://localhost:6379/0

# --- Celery --------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Security ------------------------------------------------------------------
# Leave empty for local-only mutations. Set a long random value before any nonlocal
# exposure; the API-key middleware will then require it on mutating requests.
API_KEY=
# Comma-separated allow-list of CORS origins (no wildcards; allow_credentials is off).
# The no-build static frontend (ADR 0007) is served with no build step, e.g.:
#   python -m http.server 3000 --directory frontend
# which is reachable at both host spellings, so both are allow-listed by default.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Postgres container bootstrap (used by docker-compose) ---------------------
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news
# Host port the container's 5432 is published on. Change it when a local PostgreSQL
# already owns 5432. Host-run processes (pytest, alembic) read this too, so DATABASE_URL
# above must use the same port.
POSTGRES_HOST_PORT=5432
