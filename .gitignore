# Local planning and implementation documentation (intentionally not published).
# Operational runbooks are release artifacts and must remain visible to version control.
/docs/*
!/docs/operations/
# Stage 9's frozen opening-baseline protocol is a required test input. Keep the
# rest of the local evaluation notes private while delivering this one file.
!/docs/evaluation/
/docs/evaluation/*
!/docs/evaluation/stage9-validation-protocol.md
/BUILDING_PLAN.md
/backend_platform_building_plan.md
/build.md
/frontend/uploads/frontend_building_plan.md
/incomplete.md

# Raw personal-workflow backups, reviewer transcripts, and local scheduler state.
# Retain these files locally; publish the acceptance summaries and checked outputs.
/personal-project-conversion/evidence/**/*.sql
