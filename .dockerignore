# Keep build context lean and secrets/artifacts out of images.

# Secrets / local environment
.env
.env.*
secrets
secrets/
*.pem
*.key

# Python virtualenvs and caches
.git
.venv
venv
__pycache__/
*.py[cod]
.pytest_cache
.ruff_cache

# OS / editor cruft
.DS_Store

# Build / distribution / coverage artifacts
build/
dist/
*.egg-info/
.coverage
coverage.xml
htmlcov/

# Frontend is managed by a separate plan and is not part of backend images.
frontend/
frontend/screenshots/
frontend/uploads/
